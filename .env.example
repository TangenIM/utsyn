# Copy to .env.local for local use. Set these as private server variables on your host.
DATABASE_URL=postgres://user:password@host:5432/utsyn
# For a hosted database requiring TLS, enable certificate verification:
# DATABASE_SSL=require
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SETUP_TOKEN=replace-with-a-separate-random-setup-secret
APP_URL=http://localhost:3000
TRUST_PROXY=false
# Set true only behind a gateway that overwrites X-Forwarded-For with the client IP
# and prevents direct access to the Next.js server. Otherwise limits are shared.
# Production APP_URL must be your exact public HTTPS origin.
SMS_PROVIDER=disabled
# To enable Twilio, set SMS_PROVIDER=twilio and fill all three values:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
