# Copy to .env.local for local use. Set these as private server variables on your host.
DATABASE_URL=postgres://user:password@host:5432/utsyn
# For a hosted database requiring TLS, enable certificate verification:
# DATABASE_SSL=require
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SETUP_TOKEN=replace-with-a-separate-random-setup-secret
APP_URL=http://localhost:3000
TRUST_PROXY=false
# Set true only behind a gateway that overwrites X-Forwarded-For with the client IP
# and prevents direct access to the Next.js server. Otherwise limits are shared.
# Production APP_URL must be your exact public HTTPS origin.
# Guest notifications: email (default), disabled, twilio or webhook. SMS stays available as a backup.
SMS_PROVIDER=email
# Email is sent over SMTP with STARTTLS (port 587) or TLS (port 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-the-smtp-or-app-password
# Optional visible sender address, defaults to SMTP_USER
SMTP_FROM=
# Optional, comma separated. Staff who get a message for each new booking. Overrides the admin setting.
EMAIL_STAFF_RECIPIENTS=
# To enable Twilio as a backup, set SMS_PROVIDER=twilio and fill all three values:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
